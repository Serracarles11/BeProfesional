-- WARNING: This schema is for context only and is not meant to be run.
-- Table order and constraints may not be valid for execution.

CREATE TABLE public.archivos_multimedia (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  subido_por uuid NOT NULL,
  tipo USER-DEFINED NOT NULL,
  ruta_storage text,
  url_externa text,
  titulo text NOT NULL,
  descripcion text,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT archivos_multimedia_pkey PRIMARY KEY (id),
  CONSTRAINT archivos_multimedia_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT archivos_multimedia_subido_por_fkey FOREIGN KEY (subido_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.asistencia_entrenamientos (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  entrenamiento_id uuid NOT NULL,
  jugador_id uuid NOT NULL,
  estado USER-DEFINED NOT NULL DEFAULT 'ASISTE'::estado_asistencia,
  rpe integer CHECK (rpe IS NULL OR rpe >= 1 AND rpe <= 10),
  feedback_jugador text,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT asistencia_entrenamientos_pkey PRIMARY KEY (id),
  CONSTRAINT asistencia_entrenamientos_entrenamiento_id_fkey FOREIGN KEY (entrenamiento_id) REFERENCES public.entrenamientos_equipo(id),
  CONSTRAINT asistencia_entrenamientos_jugador_id_fkey FOREIGN KEY (jugador_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.chat_mensajes (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  chat_id uuid NOT NULL,
  emisor_id uuid NOT NULL,
  contenido text NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT chat_mensajes_pkey PRIMARY KEY (id),
  CONSTRAINT chat_mensajes_chat_id_fkey FOREIGN KEY (chat_id) REFERENCES public.chats(id),
  CONSTRAINT chat_mensajes_emisor_id_fkey FOREIGN KEY (emisor_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.chat_mensajes_guardados (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  usuario_id uuid NOT NULL,
  mensaje_id uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT chat_mensajes_guardados_pkey PRIMARY KEY (id),
  CONSTRAINT chat_mensajes_guardados_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id),
  CONSTRAINT chat_mensajes_guardados_mensaje_id_fkey FOREIGN KEY (mensaje_id) REFERENCES public.chat_mensajes(id)
);
CREATE TABLE public.chats (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  titulo text NOT NULL,
  creado_por uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT chats_pkey PRIMARY KEY (id),
  CONSTRAINT chats_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT chats_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.checkins_diarios (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  jugador_id uuid NOT NULL,
  fecha date NOT NULL,
  horas_sueno numeric CHECK (horas_sueno IS NULL OR horas_sueno >= 0::numeric AND horas_sueno <= 24::numeric),
  animo integer CHECK (animo IS NULL OR animo >= 1 AND animo <= 10),
  fatiga integer CHECK (fatiga IS NULL OR fatiga >= 1 AND fatiga <= 10),
  dolor_muscular integer CHECK (dolor_muscular IS NULL OR dolor_muscular >= 1 AND dolor_muscular <= 10),
  estres integer CHECK (estres IS NULL OR estres >= 1 AND estres <= 10),
  molestias_lesion text,
  comentario text,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT checkins_diarios_pkey PRIMARY KEY (id),
  CONSTRAINT checkins_diarios_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT checkins_diarios_jugador_id_fkey FOREIGN KEY (jugador_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.clasificacion_liga (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL UNIQUE,
  posicion integer NOT NULL,
  puntos integer NOT NULL DEFAULT 0,
  partidos_jugados integer NOT NULL DEFAULT 0,
  victorias integer NOT NULL DEFAULT 0,
  empates integer NOT NULL DEFAULT 0,
  derrotas integer NOT NULL DEFAULT 0,
  goles_favor integer NOT NULL DEFAULT 0,
  goles_contra integer NOT NULL DEFAULT 0,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT clasificacion_liga_pkey PRIMARY KEY (id),
  CONSTRAINT clasificacion_liga_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id)
);
CREATE TABLE public.codigos_invitacion_equipo (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  codigo text NOT NULL UNIQUE,
  rol_asignado USER-DEFINED NOT NULL,
  usos_maximos integer NOT NULL CHECK (usos_maximos > 0),
  usos_actuales integer NOT NULL DEFAULT 0 CHECK (usos_actuales >= 0),
  caduca_en timestamp with time zone,
  activo boolean NOT NULL DEFAULT true,
  creado_por uuid,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT codigos_invitacion_equipo_pkey PRIMARY KEY (id),
  CONSTRAINT codigos_invitacion_equipo_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT codigos_invitacion_equipo_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.ejercicios (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid,
  nombre text NOT NULL,
  descripcion text,
  tipo USER-DEFINED,
  objetivo text,
  duracion_estimada_min integer CHECK (duracion_estimada_min IS NULL OR duracion_estimada_min >= 1 AND duracion_estimada_min <= 300),
  dificultad integer CHECK (dificultad IS NULL OR dificultad >= 1 AND dificultad <= 5),
  material text,
  creado_por uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT ejercicios_pkey PRIMARY KEY (id),
  CONSTRAINT ejercicios_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT ejercicios_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.ejercicios_entrenamiento (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  entrenamiento_id uuid NOT NULL,
  ejercicio_id uuid NOT NULL,
  orden integer NOT NULL DEFAULT 1,
  series integer,
  repeticiones integer,
  tiempo_trabajo_seg integer,
  tiempo_descanso_seg integer,
  instrucciones text,
  CONSTRAINT ejercicios_entrenamiento_pkey PRIMARY KEY (id),
  CONSTRAINT ejercicios_entrenamiento_entrenamiento_id_fkey FOREIGN KEY (entrenamiento_id) REFERENCES public.entrenamientos_equipo(id),
  CONSTRAINT ejercicios_entrenamiento_ejercicio_id_fkey FOREIGN KEY (ejercicio_id) REFERENCES public.ejercicios(id)
);
CREATE TABLE public.entrenamiento_asistencias (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  entrenamiento_id uuid NOT NULL,
  usuario_id uuid NOT NULL,
  asiste boolean NOT NULL,
  actualizado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT entrenamiento_asistencias_pkey PRIMARY KEY (id),
  CONSTRAINT entrenamiento_asistencias_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT entrenamiento_asistencias_entrenamiento_id_fkey FOREIGN KEY (entrenamiento_id) REFERENCES public.entrenamientos_equipo(id),
  CONSTRAINT entrenamiento_asistencias_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.entrenamiento_destinatarios (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  entrenamiento_id uuid NOT NULL,
  usuario_id uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT entrenamiento_destinatarios_pkey PRIMARY KEY (id),
  CONSTRAINT entrenamiento_destinatarios_entrenamiento_id_fkey FOREIGN KEY (entrenamiento_id) REFERENCES public.entrenamientos_equipo(id),
  CONSTRAINT entrenamiento_destinatarios_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.entrenamientos_equipo (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  fecha date NOT NULL,
  hora_inicio time without time zone,
  hora_fin time without time zone,
  titulo text NOT NULL,
  tipo USER-DEFINED NOT NULL,
  intensidad integer CHECK (intensidad IS NULL OR intensidad >= 1 AND intensidad <= 10),
  lugar text,
  notas text,
  estado USER-DEFINED NOT NULL DEFAULT 'BORRADOR'::estado_entrenamiento,
  creado_por uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT entrenamientos_equipo_pkey PRIMARY KEY (id),
  CONSTRAINT entrenamientos_equipo_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT entrenamientos_equipo_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.equipos (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  nombre text NOT NULL,
  club text,
  categoria text,
  temporada text,
  creado_por uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  logo_url text,
  CONSTRAINT equipos_pkey PRIMARY KEY (id),
  CONSTRAINT equipos_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.eventos_partido (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  partido_id uuid NOT NULL,
  minuto integer NOT NULL CHECK (minuto >= 0 AND minuto <= 130),
  tipo USER-DEFINED NOT NULL,
  jugador_id uuid,
  jugador_relacionado_id uuid,
  jugador_externo_id uuid,
  jugador_externo_relacionado_id uuid,
  CONSTRAINT eventos_partido_pkey PRIMARY KEY (id),
  CONSTRAINT eventos_partido_partido_id_fkey FOREIGN KEY (partido_id) REFERENCES public.partidos(id),
  CONSTRAINT eventos_partido_jugador_id_fkey FOREIGN KEY (jugador_id) REFERENCES public.perfiles(id),
  CONSTRAINT eventos_partido_jugador_relacionado_id_fkey FOREIGN KEY (jugador_relacionado_id) REFERENCES public.perfiles(id),
  CONSTRAINT eventos_partido_jugador_externo_relacionado_id_fkey FOREIGN KEY (jugador_externo_relacionado_id) REFERENCES public.jugadores_externos(id),
  CONSTRAINT eventos_partido_jugador_externo_id_fkey FOREIGN KEY (jugador_externo_id) REFERENCES public.jugadores_externos(id)
);
CREATE TABLE public.home_bienestar_diario (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  usuario_id uuid NOT NULL,
  fecha date NOT NULL,
  estado_mental smallint CHECK (estado_mental IS NULL OR estado_mental >= 1 AND estado_mental <= 10),
  fatiga smallint CHECK (fatiga IS NULL OR fatiga >= 1 AND fatiga <= 10),
  asiste_entrenamiento boolean,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  actualizado_en timestamp with time zone NOT NULL DEFAULT now(),
  estado_mental_actualizado_en timestamp with time zone,
  fatiga_actualizada_en timestamp with time zone,
  CONSTRAINT home_bienestar_diario_pkey PRIMARY KEY (id),
  CONSTRAINT home_bienestar_diario_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT home_bienestar_diario_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.ia_conversaciones (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  usuario_id uuid NOT NULL,
  modo USER-DEFINED NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT ia_conversaciones_pkey PRIMARY KEY (id),
  CONSTRAINT ia_conversaciones_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT ia_conversaciones_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.ia_mensajes (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  conversacion_id uuid NOT NULL,
  rol text NOT NULL CHECK (rol = ANY (ARRAY['usuario'::text, 'asistente'::text, 'sistema'::text])),
  contenido text NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT ia_mensajes_pkey PRIMARY KEY (id),
  CONSTRAINT ia_mensajes_conversacion_id_fkey FOREIGN KEY (conversacion_id) REFERENCES public.ia_conversaciones(id)
);
CREATE TABLE public.ia_recomendaciones (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  usuario_id uuid,
  tipo text NOT NULL,
  datos jsonb NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT ia_recomendaciones_pkey PRIMARY KEY (id),
  CONSTRAINT ia_recomendaciones_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT ia_recomendaciones_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.import_runs (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  categoria text NOT NULL,
  last_run_at timestamp with time zone,
  status text NOT NULL DEFAULT 'pending'::text,
  details jsonb NOT NULL DEFAULT '{}'::jsonb,
  CONSTRAINT import_runs_pkey PRIMARY KEY (id),
  CONSTRAINT import_runs_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id)
);
CREATE TABLE public.jugadores_externos (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  external_id text,
  nombre text NOT NULL,
  dorsal integer,
  posicion text,
  fuente text NOT NULL DEFAULT 'ffib'::text,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  minutes_total integer NOT NULL DEFAULT 0,
  goals_total integer NOT NULL DEFAULT 0,
  yellows_total integer NOT NULL DEFAULT 0,
  starts_total integer NOT NULL DEFAULT 0,
  CONSTRAINT jugadores_externos_pkey PRIMARY KEY (id),
  CONSTRAINT jugadores_externos_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id)
);
CREATE TABLE public.miembros_equipo (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  usuario_id uuid NOT NULL,
  rol USER-DEFINED NOT NULL,
  dorsal integer CHECK (dorsal IS NULL OR dorsal >= 1 AND dorsal <= 99),
  estado USER-DEFINED NOT NULL DEFAULT 'ACTIVO'::estado_miembro,
  fecha_alta timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT miembros_equipo_pkey PRIMARY KEY (id),
  CONSTRAINT miembros_equipo_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT miembros_equipo_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.multimedia_ejercicios (
  ejercicio_id uuid NOT NULL,
  archivo_id uuid NOT NULL,
  CONSTRAINT multimedia_ejercicios_pkey PRIMARY KEY (ejercicio_id, archivo_id),
  CONSTRAINT multimedia_ejercicios_ejercicio_id_fkey FOREIGN KEY (ejercicio_id) REFERENCES public.ejercicios(id),
  CONSTRAINT multimedia_ejercicios_archivo_id_fkey FOREIGN KEY (archivo_id) REFERENCES public.archivos_multimedia(id)
);
CREATE TABLE public.multimedia_entrenamientos (
  entrenamiento_id uuid NOT NULL,
  archivo_id uuid NOT NULL,
  CONSTRAINT multimedia_entrenamientos_pkey PRIMARY KEY (entrenamiento_id, archivo_id),
  CONSTRAINT multimedia_entrenamientos_entrenamiento_id_fkey FOREIGN KEY (entrenamiento_id) REFERENCES public.entrenamientos_equipo(id),
  CONSTRAINT multimedia_entrenamientos_archivo_id_fkey FOREIGN KEY (archivo_id) REFERENCES public.archivos_multimedia(id)
);
CREATE TABLE public.multimedia_partidos (
  partido_id uuid NOT NULL,
  archivo_id uuid NOT NULL,
  CONSTRAINT multimedia_partidos_pkey PRIMARY KEY (partido_id, archivo_id),
  CONSTRAINT multimedia_partidos_partido_id_fkey FOREIGN KEY (partido_id) REFERENCES public.partidos(id),
  CONSTRAINT multimedia_partidos_archivo_id_fkey FOREIGN KEY (archivo_id) REFERENCES public.archivos_multimedia(id)
);
CREATE TABLE public.notas_rival (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  rival_nombre text NOT NULL,
  partido_id uuid,
  titulo text NOT NULL,
  contenido text NOT NULL,
  creado_por uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT notas_rival_pkey PRIMARY KEY (id),
  CONSTRAINT notas_rival_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT notas_rival_partido_id_fkey FOREIGN KEY (partido_id) REFERENCES public.partidos(id),
  CONSTRAINT notas_rival_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.notas_rival_archivos (
  nota_id uuid NOT NULL,
  archivo_id uuid NOT NULL,
  CONSTRAINT notas_rival_archivos_pkey PRIMARY KEY (nota_id, archivo_id),
  CONSTRAINT notas_rival_archivos_nota_id_fkey FOREIGN KEY (nota_id) REFERENCES public.notas_rival(id),
  CONSTRAINT notas_rival_archivos_archivo_id_fkey FOREIGN KEY (archivo_id) REFERENCES public.archivos_multimedia(id)
);
CREATE TABLE public.notificaciones (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  usuario_id uuid NOT NULL,
  tipo USER-DEFINED NOT NULL,
  titulo text NOT NULL,
  mensaje text NOT NULL,
  link text,
  leida boolean NOT NULL DEFAULT false,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT notificaciones_pkey PRIMARY KEY (id),
  CONSTRAINT notificaciones_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.participantes_partido (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  partido_id uuid NOT NULL,
  jugador_id uuid NOT NULL,
  convocado boolean NOT NULL DEFAULT true,
  titular boolean NOT NULL DEFAULT false,
  minutos_jugados integer CHECK (minutos_jugados IS NULL OR minutos_jugados >= 0 AND minutos_jugados <= 130),
  posicion USER-DEFINED,
  valoracion integer CHECK (valoracion IS NULL OR valoracion >= 1 AND valoracion <= 10),
  notas text,
  jugador_externo_id uuid,
  CONSTRAINT participantes_partido_pkey PRIMARY KEY (id),
  CONSTRAINT participantes_partido_partido_id_fkey FOREIGN KEY (partido_id) REFERENCES public.partidos(id),
  CONSTRAINT participantes_partido_jugador_id_fkey FOREIGN KEY (jugador_id) REFERENCES public.perfiles(id),
  CONSTRAINT participantes_partido_jugador_externo_id_fkey FOREIGN KEY (jugador_externo_id) REFERENCES public.jugadores_externos(id)
);
CREATE TABLE public.partidos (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  fecha_hora timestamp with time zone NOT NULL,
  competicion text,
  casa_fuera USER-DEFINED NOT NULL,
  rival_nombre text NOT NULL,
  lugar text,
  estado USER-DEFINED NOT NULL DEFAULT 'PROGRAMADO'::estado_partido,
  goles_favor integer CHECK (goles_favor IS NULL OR goles_favor >= 0),
  goles_contra integer CHECK (goles_contra IS NULL OR goles_contra >= 0),
  notas_entrenador text,
  creado_por uuid NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT partidos_pkey PRIMARY KEY (id),
  CONSTRAINT partidos_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT partidos_creado_por_fkey FOREIGN KEY (creado_por) REFERENCES public.perfiles(id)
);
CREATE TABLE public.perfiles (
  id uuid NOT NULL,
  nombre text NOT NULL,
  foto_url text,
  fecha_nacimiento date,
  posicion USER-DEFINED,
  pie_dominante USER-DEFINED,
  altura_cm integer CHECK (altura_cm IS NULL OR altura_cm >= 100 AND altura_cm <= 250),
  peso_kg numeric CHECK (peso_kg IS NULL OR peso_kg >= 20::numeric AND peso_kg <= 300::numeric),
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  actualizado_en timestamp with time zone NOT NULL DEFAULT now(),
  genero USER-DEFINED,
  edad integer CHECK (edad IS NULL OR edad >= 5 AND edad <= 80),
  perfil_completo boolean NOT NULL DEFAULT false,
  telefono text,
  ciudad text,
  pais text,
  bio text,
  instagram text,
  objetivo text,
  CONSTRAINT perfiles_pkey PRIMARY KEY (id),
  CONSTRAINT perfiles_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id)
);
CREATE TABLE public.planes_individuales (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  jugador_id uuid NOT NULL,
  entrenador_id uuid NOT NULL,
  fecha_inicio date NOT NULL,
  fecha_fin date NOT NULL,
  objetivo text,
  notas text,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT planes_individuales_pkey PRIMARY KEY (id),
  CONSTRAINT planes_individuales_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT planes_individuales_jugador_id_fkey FOREIGN KEY (jugador_id) REFERENCES public.perfiles(id),
  CONSTRAINT planes_individuales_entrenador_id_fkey FOREIGN KEY (entrenador_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.players (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  external_id text,
  name text NOT NULL,
  team text NOT NULL,
  position text,
  nationality text,
  age integer,
  market_value bigint,
  source_url text NOT NULL,
  scraped_at timestamp with time zone NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT timezone('utc'::text, now()),
  updated_at timestamp with time zone NOT NULL DEFAULT timezone('utc'::text, now()),
  minutes_total integer NOT NULL DEFAULT 0,
  goals_total integer NOT NULL DEFAULT 0,
  yellows_total integer NOT NULL DEFAULT 0,
  starts_total integer NOT NULL DEFAULT 0,
  CONSTRAINT players_pkey PRIMARY KEY (id)
);
CREATE TABLE public.playmaker_plays (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  usuario_id uuid NOT NULL,
  equipo_id uuid,
  titulo text NOT NULL,
  draft jsonb NOT NULL,
  creado_en timestamp with time zone NOT NULL DEFAULT timezone('utc'::text, now()),
  actualizado_en timestamp with time zone NOT NULL DEFAULT timezone('utc'::text, now()),
  CONSTRAINT playmaker_plays_pkey PRIMARY KEY (id),
  CONSTRAINT playmaker_plays_usuario_id_fkey FOREIGN KEY (usuario_id) REFERENCES auth.users(id),
  CONSTRAINT playmaker_plays_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id)
);
CREATE TABLE public.registros_actividad (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  equipo_id uuid NOT NULL,
  jugador_id uuid NOT NULL,
  fecha_hora timestamp with time zone NOT NULL,
  tipo USER-DEFINED NOT NULL,
  duracion_min integer NOT NULL CHECK (duracion_min >= 1 AND duracion_min <= 600),
  distancia_km numeric CHECK (distancia_km IS NULL OR distancia_km >= 0::numeric),
  rpe_esfuerzo integer CHECK (rpe_esfuerzo IS NULL OR rpe_esfuerzo >= 1 AND rpe_esfuerzo <= 10),
  carga integer,
  notas text,
  creado_en timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT registros_actividad_pkey PRIMARY KEY (id),
  CONSTRAINT registros_actividad_equipo_id_fkey FOREIGN KEY (equipo_id) REFERENCES public.equipos(id),
  CONSTRAINT registros_actividad_jugador_id_fkey FOREIGN KEY (jugador_id) REFERENCES public.perfiles(id)
);
CREATE TABLE public.tareas_plan_individual (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  plan_id uuid NOT NULL,
  ejercicio_id uuid,
  fecha_programada date,
  duracion_objetivo_min integer CHECK (duracion_objetivo_min IS NULL OR duracion_objetivo_min >= 1 AND duracion_objetivo_min <= 300),
  intensidad_objetivo integer CHECK (intensidad_objetivo IS NULL OR intensidad_objetivo >= 1 AND intensidad_objetivo <= 10),
  obligatorio boolean NOT NULL DEFAULT true,
  notas text,
  CONSTRAINT tareas_plan_individual_pkey PRIMARY KEY (id),
  CONSTRAINT tareas_plan_individual_plan_id_fkey FOREIGN KEY (plan_id) REFERENCES public.planes_individuales(id),
  CONSTRAINT tareas_plan_individual_ejercicio_id_fkey FOREIGN KEY (ejercicio_id) REFERENCES public.ejercicios(id)
);